        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.myarana.customer",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f329fe66-f78d-4404-944e-6957ffd7beca"
      }
    },
    "owner": "miftahsteven",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "sounds": [
            "notification.wav"
          ]
        }
      ],
      "expo-secure-store",
      "expo-image-picker"
    ]
  }
}